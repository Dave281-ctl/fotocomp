# Öffentliche Adresse der Plattform (ohne Schrägstrich am Ende)
ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://fotocomp:fotocomp@localhost:5432/fotocomp

# Höchste Grösse eines Fotos in MB (Standard 200, RAW-Dateien sind gross)
# MAX_UPLOAD_MB=200

# Ablage der Fotos (Originale und Thumbnails)
DATA_DIR=./data

# Mailversand (lokal: Mailpit aus compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fotocomp <fotocomp@example.com>"

# Nur Entwicklung: simulierte aktuelle Zeit, z.B. 2026-11-18T20:30
# FAKE_NOW=
