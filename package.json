{
	"name": "fotocomp",
	"version": "0.6.0",
	"description": "Ein schlichter Foto-Wettbewerb unter Freunden",
	"license": "MIT",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:up": "podman-compose -f compose.dev.yml up -d",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
		"prepare": "svelte-kit sync || echo \"\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@types/nodemailer": "^8.0.2",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.75.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"exiftool-vendored": "^39.4.0",
		"heic-decode": "^2.1.0",
		"nodemailer": "^10.6.0",
		"postgres": "^4.1.1",
		"sharp": "^0.35.5",
		"web-push": "^3.6.7"
	}
}
