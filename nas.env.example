# =============================================================================
#  Fotocomp – persönliche Einstellungen (.env)
# =============================================================================
#
#  So gehts:
#   1. Diesen ganzen Text kopieren und auf dem NAS als Datei «.env» speichern,
#      im selben Ordner wie die compose.yaml (z.B. /volume1/docker/fotocomp/.env).
#   2. Im Teil «MUSS ANGEPASST WERDEN» jeden Wert ersetzen, der mit HIER_
#      beginnt bzw. example.com enthält. Der Teil «KANN SO BLEIBEN» passt meist.
#   3. Container Manager → Projekt stoppen → Erstellen. Ein Neustart allein
#      übernimmt Änderungen an dieser Datei nicht.
#
#  Regeln für diese Datei:
#   - Pro Zeile eine Einstellung: NAME=Wert, ohne Leerzeichen um das «=».
#   - Keine Anführungszeichen um die Werte.
#   - Passwörter und Schlüssel nur aus A–Z, a–z und 0–9 (mind. 30 Zeichen).
#     Zeichen wie $ oder # haben hier eine Sonderbedeutung und verfälschen den
#     Wert. Tipp: Passwort-Generator deines Passwortmanagers verwenden.
#   - Die Datei muss mit einem Zeilenumbruch enden; neue Zeilen immer auf einer
#     eigenen Zeile ergänzen.
#
#  Fotocomp meldet beim Start im Protokoll des App-Containers, wenn noch ein
#  Platzhalter (HIER_ …) übrig ist.


# #############################################################################
#  MUSS ANGEPASST WERDEN
# #############################################################################

# ---- Webadresse -------------------------------------------------------------
# Die Adresse, unter der Fotocomp im Browser erreichbar ist, mit https:// und
# ohne Schrägstrich am Ende. Muss genau stimmen, sonst funktionieren Login und
# Formulare nicht.
ORIGIN=https://fotos.example.com

# ---- Datenbank-Passwort -----------------------------------------------------
# Frei wählbar, wird nur intern zwischen App und Datenbank verwendet.
# Achtung: Gilt nur beim allerersten Start (leerer db-Ordner). Später ändern
# siehe README → Fehlerbehebung.
DB_PASSWORD=HIER_LANGES_ZUFALLSPASSWORT_EINSETZEN

# ---- Mailversand ------------------------------------------------------------
# Die Zugangsdaten deines Mail-Anbieters (für Login-Links und Erinnerungen).
# Port 587 = STARTTLS, Port 465 = TLS – die Verschlüsselung wird passend gewählt.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=fotocomp@example.com
SMTP_PASS=HIER_MAIL_PASSWORT_EINSETZEN
# Absender, wie er im Postfach erscheint: Name <Adresse>
MAIL_FROM=Fotocomp <fotocomp@example.com>

# ---- Updates ----------------------------------------------------------------
# Gemeinsamer Schlüssel von App und Watchtower: Nur wer ihn kennt, darf ein
# Update auslösen. Frei wählbar, du musst ihn dir nicht merken.
# Ob und welche Updates automatisch kommen, stellst du im Adminbereich ein.
UPDATE_TOKEN=HIER_LANGEN_ZUFALLSSCHLUESSEL_EINSETZEN


# #############################################################################
#  KANN SO BLEIBEN
# #############################################################################

# Port auf dem NAS, an den der Reverse Proxy weiterleitet
# (Reverse Proxy → Ziel: http://localhost:<APP_PORT>).
APP_PORT=3000

# Benutzer und Name der Datenbank. Gelten wie das Passwort nur beim
# allerersten Start.
DB_USERNAME=fotocomp
DB_DATABASE_NAME=fotocomp
