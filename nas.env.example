# Vorlage für die Datei .env neben compose.yaml auf dem NAS.
# Kopieren, als «.env» speichern und die Werte anpassen.

# ---- Datenbank -------------------------------------------------------------
# Passwort für PostgreSQL. Bitte ein langes, zufälliges Passwort nur aus
# A-Z, a-z und 0-9 verwenden: Zeichen wie $ oder # haben in dieser Datei
# eine Sonderbedeutung und würden das Passwort verfälschen.
# Wichtig: Benutzer, Passwort und Datenbankname gelten nur beim allerersten Start
# (leerer db-Ordner). Wer sie später ändert, siehe README → Fehlerbehebung.
DB_PASSWORD=AendernLangesZufallsPasswort123

DB_USERNAME=fotocomp
DB_DATABASE_NAME=fotocomp

# ---- Webadresse ------------------------------------------------------------
# Öffentliche Adresse, wie sie im Browser steht (ohne Schrägstrich am Ende).
ORIGIN=https://fotos.example.com
# Port auf dem NAS, an den der Reverse Proxy weiterleitet.
APP_PORT=3000

# ---- Mailversand -----------------------------------------------------------
# Port 465 = TLS, Port 587 = STARTTLS. Die Verschlüsselung wird automatisch
# passend zum Port gewählt.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=fotocomp@example.com
SMTP_PASS=AendernMailPasswort
MAIL_FROM=Fotocomp <fotocomp@example.com>
